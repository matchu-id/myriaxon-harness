# Myriaxon configuration template.
#
# COPY THIS FILE to `.env` and fill in what you need:
#
#     cp .env.example .env          # macOS / Linux
#     copy .env.example .env        # Windows
#
# `.env` is gitignored. This file is not, which is the point: it shows the shape of a
# configuration without ever being one. Never put a real key in THIS file.
#
# Precedence, highest first:
#     1. a command-line flag      (--vendor, --model, --max-tokens)
#     2. a variable in `.env`     (and then the real environment)
#     3. `~/.myriaxon/config.json` (what the setup wizard saves)
#
# So a `.env` OUTRANKS a saved choice. If you set a vendor here, it wins on the next run
# even if you picked a different one in the wizard -- which is usually what you want from a
# per-project file, and surprising exactly once.

# =============================================================================================
# WHICH PROVIDER AND MODEL
# =============================================================================================

# One of: netra | deepseek | gemini | ollama | anthropic | openrouter | openai_compat
MYRIAXON_PROVIDER=netra

# The model name, exactly as the provider spells it. `myriaxon --models` lists what your key
# can actually reach, which is more reliable than any list in a document.
MYRIAXON_MODEL=deepseek/deepseek-v4.1-flash

# Only needed for a provider that is not one of the built-ins. Leave it out otherwise: the
# built-in endpoints are already correct, and setting this by hand for a known provider is
# how a request ends up at the wrong host.
#MYRIAXON_BASE_URL=

# =============================================================================================
# CREDENTIALS -- set the one your provider needs, and nothing else.
#
# These are the names the tools' own documentation uses, so a key you already have exported
# for another purpose is picked up without being copied anywhere.
# =============================================================================================

# Netra (api.netraruntime.com) -- serves the same models as DeepSeek's own API.
#NETRA_API_KEY=

# DeepSeek's own API (api.deepseek.com).
#DEEPSEEK_API_KEY=

# OpenRouter.
#OPENROUTER_API_KEY=

# Google AI Studio key. NOT needed for Vertex AI -- Vertex uses your gcloud login instead,
# so leave this unset and see GOOGLE_* below.
#GEMINI_API_KEY=

# Anthropic.
#ANTHROPIC_API_KEY=

# A generic key, used only when the provider above has no specific variable set. This is the
# escape hatch for `openai_compat` and for a gateway nobody has heard of yet.
#MYRIAXON_API_KEY=

# =============================================================================================
# GEMINI THROUGH VERTEX AI -- no API key at all, billed to a Google Cloud project.
#
# With these three set, the credential is your `gcloud auth` login. See
# docs/VERTEX-SETUP.md for the federated (workforce identity) variant as well.
# =============================================================================================

#GOOGLE_GENAI_USE_VERTEXAI=true
#GOOGLE_CLOUD_PROJECT=your-project-id
#GOOGLE_CLOUD_LOCATION=global

# Myriaxon-specific overrides, if you need a project or region different from the two above.
#MYRIAXON_VERTEX_PROJECT=
#MYRIAXON_VERTEX_LOCATION=
#MYRIAXON_VERTEX_MODEL=

# =============================================================================================
# OLLAMA -- a model on this computer, no key and no account.
# =============================================================================================

# Not needed if you pass --ollama, which detects what is installed.
#MYRIAXON_PROVIDER=ollama
#MYRIAXON_MODEL=llama3.1

# =============================================================================================
# HOW MUCH TO SHOW
# =============================================================================================

# The transparency dial, 0-8. Each level includes everything below it:
#   0 silent  1 pulse  2 intent  3 actions  4 files  5 system  6 agents  7 decisions  8 memory
# The dashboard has a slider for the same setting. See docs/HOW-TO-USE.md.
#MYRIAXON_TRANSPARENCY=3

# Per-phase timing to stderr, for "why is startup slow".
#MYRIAXON_TIMING=1

# Set to 1 to let the dashboard's 60-second supervisor run Loci while it is open. On by
# default; this turns it off.
#MYRIAXON_NO_SUPERVISOR=1

# How often the supervisor looks, in seconds.
#MYRIAXON_SUPERVISOR_SECONDS=60

# =============================================================================================
# CONTEXT
# =============================================================================================

# Override the window Myriaxon budgets against. Worth setting when a gateway serves a model
# whose real window is larger than the built-in table assumes -- the table is deliberately
# conservative, so an unset value costs capability rather than correctness.
#MYRIAXON_CONTEXT_WINDOW=1000000

# =============================================================================================
# ESCAPE HATCHES THAT WEAKEN A DEFAULT -- enable only if you have decided to.
# =============================================================================================

# Let `web_fetch` reach loopback, RFC1918 and cloud-metadata addresses. Refused by default:
# a fetch reaches every service this machine can route to, including ones bound to localhost.
#MYRIAXON_ALLOW_PRIVATE_FETCH=1

# Point Myriaxon at a configuration directory other than ~/.myriaxon.
#MYRIAXON_CONFIG_DIR=
